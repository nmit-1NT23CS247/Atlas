# Application Settings
APP_NAME="Atlas Build & Release API"
APP_VERSION="0.1.0"
ENVIRONMENT="development"
DEBUG=true
LOG_LEVEL="INFO"

# Server Host & Port
HOST="0.0.0.0"
PORT=8000

# API Versioning Prefix
API_V1_PREFIX="/api/v1"

# CORS Allowed Origins (Comma-separated or JSON list)
# Strictly restricted to local Atlas frontend dev server
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# Database Connection (PostgreSQL with psycopg 3 driver)
# Note: PostgreSQL connection is configured in Milestone 2
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/atlas"
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
