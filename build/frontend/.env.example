# VITE_USE_MOCK: Set to 'true' to run fully on realistic in-memory mock data
# Set to 'false' to communicate with the real backend API
VITE_USE_MOCK=true

# VITE_API_BASE_URL: Base URL for real GitLab CI/CD build management backend
VITE_API_BASE_URL="https://gitlab-ci.internal.corp/api/v1"

# GEMINI_API_KEY: Required for Gemini AI API calls (if applicable)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted
APP_URL="MY_APP_URL"
